# Copy to .env.local and fill in real values from Supabase → Project Settings → API.
# Never commit .env.local — it's already in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vapi — from the Vapi dashboard's API Keys page. Public key is safe for the
# browser (used by /talk/voice's client-side widget).
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Shared secret for app/api/webhooks/vapi — generate with `openssl rand -hex 32`,
# paste the same value into the Vapi dashboard's Server URL credential
# (header "Authorization", Bearer prefix enabled). Server-only, never NEXT_PUBLIC.
VAPI_WEBHOOK_SECRET=

# Optional — /api/submit skips sending email entirely until this is set,
# it does not block form submissions from working.
RESEND_API_KEY=
NOTIFY_EMAIL=

# Optional — defaults to https://mykiro.live (see lib/site.ts) if unset.
# Used for robots.txt, sitemap.xml, and metadataBase (OG/canonical URLs).
NEXT_PUBLIC_SITE_URL=
